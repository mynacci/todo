MONGODB_URI=mongodb://127.0.0.1:27017/todo

# GitHub OAuth App (https://github.com/settings/developers -> OAuth Apps -> New OAuth App)
# Never commit real values. Copy this file to .env.local and fill them in there.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of this app (no trailing slash). The OAuth callback is {APP_URL}/auth/github/callback
# and must exactly match the "Authorization callback URL" registered on GitHub.
# If unset, the origin of the incoming request is used in development/test, but in production
# (NODE_ENV=production) APP_URL is REQUIRED: the auth routes fail closed with 500 CONFIG.
APP_URL=http://localhost:3000
